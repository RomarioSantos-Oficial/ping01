<Window x:Class="SectorFlow.LmuNetworkAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SectorFlow LMU Network Analyzer" Height="760" Width="1120"
        MinHeight="650" MinWidth="950"
        Background="#10141A" Foreground="#F2F4F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SectorFlow LMU Network Analyzer"
                   FontSize="28" FontWeight="Bold" Margin="4,0,4,12"/>

        <Border Grid.Row="1" Background="#19212B" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="LMU process"/>
                    <TextBlock x:Name="ProcessStatusText" Text="Not detected" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Target / Race server IP"/>
                    <TextBox x:Name="TargetTextBox" Text="1.1.1.1"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ping"/>
                    <TextBlock x:Name="PingText" Text="-" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Jitter"/>
                    <TextBlock x:Name="JitterText" Text="-" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Loss"/>
                    <TextBlock x:Name="LossText" Text="-" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Detect LMU" Click="DetectLmu_Click"/>
            <Button Content="Discover server from logs" Click="DiscoverServer_Click"/>
            <Button x:Name="MonitorButton" Content="Start monitor" Click="Monitor_Click"/>
            <Button Content="Traceroute" Click="Traceroute_Click"/>
            <Button Content="MTU test" Click="Mtu_Click"/>
            <Button Content="Safe optimize" Click="Optimize_Click"/>
            <Button Content="Install LMU QoS" Click="Qos_Click"/>
            <Button Content="Export report" Click="Export_Click"/>
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="SamplesGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#151B23" Foreground="#111111"
                      AlternatingRowBackground="#E8ECF1" Margin="0,0,8,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="150"/>
                    <DataGridTextColumn Header="Ping ms" Binding="{Binding LatencyMs}" Width="90"/>
                    <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="60"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBox Grid.Column="1" x:Name="OutputTextBox"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#0B0F14" Foreground="#D7E3F4"
                     FontFamily="Consolas" FontSize="13"/>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="StatusText"
                   Text="Ready. DNS/VPN route changes are not applied automatically."
                   Foreground="#B8C4D6" Margin="4,10,4,0"/>
    </Grid>
</Window>
